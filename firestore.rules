rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estAdmin() {
      return request.auth != null
        && request.auth.uid == "3LpoTLyQdtVcdtnSMAJFc7Cvnpz2";
    }

    function estConnecte() {
      return request.auth != null;
    }
    function abonnementServices() {
      return exists(/databases/$(database)/documents/configuration_abonnements/globale)
        ? get(/databases/$(database)/documents/configuration_abonnements/globale).data.get("services", {})
        : {};
    }
    function abonnementChamp(service, champ, defaut) {
      return abonnementServices().get(service, {}).get(champ, defaut);
    }
    function abonnementAutorise(service) {
      return abonnementChamp(service, "actif", true) == true;
    }
    function dureeEnJours(service, defaut) {
      return abonnementChamp(service, "unite", "jours") == "mois"
        ? abonnementChamp(service, "duree", defaut) * 30
        : abonnementChamp(service, "duree", defaut);
    }

    function estAbonneAutomobiliste() {
      return estConnecte()
        && exists(/databases/$(database)/documents/abonnements_automobiliste/$(request.auth.uid))
        && get(/databases/$(database)/documents/abonnements_automobiliste/$(request.auth.uid)).data.statut == "actif"
        && get(/databases/$(database)/documents/abonnements_automobiliste/$(request.auth.uid)).data.dateExpiration is timestamp
        && get(/databases/$(database)/documents/abonnements_automobiliste/$(request.auth.uid)).data.dateExpiration > request.time;
    }

    function partenaire(uid) {
      return get(/databases/$(database)/documents/partenaires/$(uid)).data;
    }

    function abonnementValide(p) {
      return p.statut == "approuve"
        && (!("etatCompte" in p) || p.etatCompte == "actif")
        && (
          (p.statutAbonnementPartenaire == "Essai"
            && p.dateFinEssai is timestamp
            && p.dateFinEssai > request.time)
          ||
          (p.statutAbonnementPartenaire == "Actif"
            && p.dateExpirationAbonnement is timestamp
            && p.dateExpirationAbonnement > request.time)
        );
    }

    function partenaireEnLignePour(typeService) {
      return estConnecte()
        && exists(/databases/$(database)/documents/partenaires/$(request.auth.uid))
        && partenaire(request.auth.uid).enLigne == true
        && abonnementValide(partenaire(request.auth.uid))
        && (
          (typeService == "compagnie" && partenaire(request.auth.uid).type == "representant_gare")
          ||
          ((typeService == "livraison" || typeService == "livraison_programmee")
            && partenaire(request.auth.uid).type == "livreur_independant")
        );
    }

    function verrouPath(uid) {
      return /databases/$(database)/documents/partenaires/$(uid)/verrous/missionActive;
    }

    function commandePath(commandeId) {
      return /databases/$(database)/documents/commandes_colis/$(commandeId);
    }

    function detailsPrivesPath(commandeId) {
      return /databases/$(database)/documents/commandes_colis/$(commandeId)/informations_privees/details;
    }

    function contientChampsPrives(data) {
      return data.keys().hasAny([
        "clientNom", "clientTelephone", "telephoneExpediteur", "telephoneDestinataire",
        "adresseRecuperation", "adresseLivraison", "descriptionColis", "trackingNumber",
        "provenance", "codeColis", "typeColis", "livreurId", "operation", "compagnie",
        "gare", "latitudeRecuperation", "longitudeRecuperation",
        "latitudeLivraison", "longitudeLivraison"
      ]);
    }

    // Jetons FCM : chaque utilisateur ne peut gérer que ses propres appareils.
    match /appareils_notifications/{tokenId} {
      allow create: if estConnecte()
        && request.resource.data.keys().hasOnly(["uid","token","createdAt","plateforme","userAgent"])
        && request.resource.data.keys().hasAll(["uid","token","createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token == tokenId
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && request.resource.data.token.size() <= 4096
        && request.resource.data.createdAt == request.time
        && (!("plateforme" in request.resource.data) || request.resource.data.plateforme in ["iOS","web"])
        && (!("userAgent" in request.resource.data) || (request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300));
      allow read: if estAdmin() || (estConnecte() && resource.data.uid == request.auth.uid);
      allow update: if estConnecte()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token == tokenId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["createdAt","plateforme","userAgent"])
        && request.resource.data.createdAt == request.time;
      allow delete: if estAdmin() || (estConnecte() && resource.data.uid == request.auth.uid);
    }

    match /routes/{routeId} {
      allow read: if true;
      allow create, update, delete: if estAdmin();
    }

    match /compagnies/{compagnieId} {
      allow read: if true;
      allow create: if estAdmin()
        || (estConnecte()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.keys().hasAll([
            "uid","nom","agence","localisation","telephone","email","destinations",
            "formule","periodicite","montant","dureeMois","moyenPaiement","referencePaiement",
            "statutAbonnement","dateCreation","dateDebut","dateExpiration"
          ])
          && request.resource.data.keys().hasOnly([
            "uid","nom","agence","localisation","telephone","email","logo","destinations",
            "formule","periodicite","montant","dureeMois","moyenPaiement","referencePaiement",
            "statutAbonnement","dateCreation","dateDebut","dateExpiration"
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 100
          && request.resource.data.agence is string && request.resource.data.agence.size() > 0 && request.resource.data.agence.size() <= 100
          && request.resource.data.localisation is string && request.resource.data.localisation.size() > 0 && request.resource.data.localisation.size() <= 160
          && request.resource.data.telephone is string && request.resource.data.telephone.size() >= 8 && request.resource.data.telephone.size() <= 20
          && request.resource.data.email is string && request.resource.data.email.size() <= 120
          && request.resource.data.destinations is list && request.resource.data.destinations.size() > 0 && request.resource.data.destinations.size() <= 100
          && request.resource.data.formule in ["Essentielle","Professionnelle"]
          && request.resource.data.periodicite in ["Mensuel","Annuel"]
          && request.resource.data.montant is int && request.resource.data.montant > 0
          && request.resource.data.dureeMois is int && request.resource.data.dureeMois > 0
          && (
            (request.resource.data.formule == "Essentielle" && request.resource.data.periodicite == "Mensuel"
              && abonnementAutorise("compagnie_essentielle_mensuel")
              && request.resource.data.montant <= abonnementChamp("compagnie_essentielle_mensuel", "prix", 5000)
              && request.resource.data.dureeMois == abonnementChamp("compagnie_essentielle_mensuel", "duree", 1))
            || (request.resource.data.formule == "Essentielle" && request.resource.data.periodicite == "Annuel"
              && abonnementAutorise("compagnie_essentielle_annuel")
              && request.resource.data.montant <= abonnementChamp("compagnie_essentielle_annuel", "prix", 50000)
              && request.resource.data.dureeMois == abonnementChamp("compagnie_essentielle_annuel", "duree", 12))
            || (request.resource.data.formule == "Professionnelle" && request.resource.data.periodicite == "Mensuel"
              && abonnementAutorise("compagnie_professionnelle_mensuel")
              && request.resource.data.montant <= abonnementChamp("compagnie_professionnelle_mensuel", "prix", 10000)
              && request.resource.data.dureeMois == abonnementChamp("compagnie_professionnelle_mensuel", "duree", 1))
            || (request.resource.data.formule == "Professionnelle" && request.resource.data.periodicite == "Annuel"
              && abonnementAutorise("compagnie_professionnelle_annuel")
              && request.resource.data.montant <= abonnementChamp("compagnie_professionnelle_annuel", "prix", 100000)
              && request.resource.data.dureeMois == abonnementChamp("compagnie_professionnelle_annuel", "duree", 12))
          )
          && request.resource.data.moyenPaiement in ["Wave","Orange Money"]
          && request.resource.data.referencePaiement is string
          && request.resource.data.referencePaiement.size() >= 4
          && request.resource.data.referencePaiement.size() <= 80
          && request.resource.data.statutAbonnement == "En attente"
          && request.resource.data.dateCreation == request.time
          && request.resource.data.dateDebut == null
          && request.resource.data.dateExpiration == null
          && (!request.resource.data.keys().hasAny(["logo"])
            || (request.resource.data.logo is string && request.resource.data.logo.size() <= 300000 && (request.resource.data.logo == "" || request.resource.data.logo.matches("^data:image/jpeg;base64,.*$"))))
        );
      allow update, delete: if estAdmin();
    }

    match /gares/{gareId} {
      allow read: if true;
      allow create, update, delete: if estAdmin();
    }

    match /partenaires/{partenaireId} {
      allow read: if estAdmin()
        || (estConnecte() && request.auth.uid == partenaireId);

      allow create: if estConnecte()
        && request.auth.uid == partenaireId
        && request.resource.data.keys().hasAll([
          "uid", "type", "nom", "telephone", "commune",
          "email", "dateNaissance", "lieuNaissance",
          "numeroIdentite", "statut", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "type", "nom", "telephone", "commune",
          "email", "dateNaissance", "lieuNaissance",
          "numeroIdentite", "quartiers", "numeroPermis",
          "nomGare", "posteOccupe", "photoProfil",
          "statut", "createdAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.type == "livreur_independant"
          || request.resource.data.type == "representant_gare")
        && (
          (request.resource.data.type == "livreur_independant"
            && request.resource.data.keys().hasAll(["quartiers", "numeroPermis"]))
          ||
          (request.resource.data.type == "representant_gare"
            && request.resource.data.keys().hasAll(["nomGare", "posteOccupe"]))

        )
        && request.resource.data.statut == "en_attente"
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && (
          !request.resource.data.keys().hasAny(["photoProfil"])
          || (request.resource.data.photoProfil is string
            && request.resource.data.photoProfil.size() <= 200000
            && request.resource.data.photoProfil.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'))
        );

      allow update: if estAdmin()
        || (estConnecte()
          && request.auth.uid == partenaireId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["enLigne", "derniereActivite"])
          && request.resource.data.enLigne is bool
          && request.resource.data.derniereActivite == request.time
          && (request.resource.data.enLigne == false
            || abonnementValide(request.resource.data)));

      allow delete: if estAdmin();

      match /verrous/{verrouId} {
        allow read: if estAdmin()
          || (estConnecte() && request.auth.uid == partenaireId);
        allow create: if estConnecte()
          && (request.auth.uid == partenaireId || estAdmin())
          && verrouId == "missionActive"
          && request.resource.data.keys().hasOnly(["commandeId", "statut", "createdAt"])
          && request.resource.data.commandeId is string
          && request.resource.data.statut == "active"
          && request.resource.data.createdAt == request.time
          && partenaire(partenaireId).enLigne == true
          && abonnementValide(partenaire(partenaireId))
          && existsAfter(commandePath(request.resource.data.commandeId))
          && getAfter(commandePath(request.resource.data.commandeId)).data.partenaireId == partenaireId
          && getAfter(commandePath(request.resource.data.commandeId)).data.statut == "livreur_affecte";
        allow delete: if estAdmin()
          || (estConnecte()
            && request.auth.uid == partenaireId
            && verrouId == "missionActive"
            && resource.data.commandeId is string
            && (
              (get(commandePath(resource.data.commandeId)).data.statut == "en_attente"
                && get(commandePath(resource.data.commandeId)).data.get("partenaireId", null) == null)
              || ((get(commandePath(resource.data.commandeId)).data.statut == "livre"
                  || get(commandePath(resource.data.commandeId)).data.statut == "arrive_destination")
                && get(commandePath(resource.data.commandeId)).data.partenaireId == partenaireId)
            ));
        allow update: if false;
      }
    }

    match /clients/{clientId} {
      allow create: if estConnecte()
        && request.auth.uid == clientId
        && request.resource.data.uid == clientId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasAll(["uid", "nom", "telephone", "email", "createdAt"])
        && request.resource.data.keys().hasOnly(["uid", "nom", "telephone", "email", "createdAt"])
        && request.resource.data.createdAt == request.time;

      allow read: if estAdmin() || (estConnecte() && request.auth.uid == clientId);

      allow update: if estConnecte()
        && request.auth.uid == clientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nom", "telephone"]);

      allow delete: if estAdmin();
    }

    match /commandes_colis/{commandeId} {
      allow create: if (
        estConnecte()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.keys().hasAll(["clientId","service","depart","destination","statut","createdAt","publicVersion","typeCommande","boutiqueId","boutiqueUid","boutiqueNom","montantLivraisonBoutique"])
        && request.resource.data.keys().hasOnly(["clientId","service","depart","destination","statut","createdAt","publicVersion","typeCommande","boutiqueId","boutiqueUid","boutiqueNom","montantLivraisonBoutique"])
        && request.resource.data['service'] == "livraison"
        && request.resource.data.statut == "commande_boutique"
        && request.resource.data.publicVersion == false
        && request.resource.data.typeCommande == "boutique"
        && request.resource.data.boutiqueUid is string
        && exists(/databases/$(database)/documents/demandes_nouveaux_services/$(request.resource.data.boutiqueId))
        && get(/databases/$(database)/documents/demandes_nouveaux_services/$(request.resource.data.boutiqueId)).data.uid == request.resource.data.boutiqueUid
        && get(/databases/$(database)/documents/demandes_nouveaux_services/$(request.resource.data.boutiqueId)).data.statut == "approuve"
        && get(/databases/$(database)/documents/demandes_nouveaux_services/$(request.resource.data.boutiqueId)).data.abonnementFin is timestamp
        && get(/databases/$(database)/documents/demandes_nouveaux_services/$(request.resource.data.boutiqueId)).data.abonnementFin > request.time
        && request.resource.data.montantLivraisonBoutique in [1000,1500,2000,2500]
        && existsAfter(/databases/$(database)/documents/commandes_colis/$(commandeId)/informations_privees/details)
        && getAfter(/databases/$(database)/documents/commandes_colis/$(commandeId)/informations_privees/details).data.clientId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/commandes_colis/$(commandeId)/tarification/prix)
        && getAfter(/databases/$(database)/documents/commandes_colis/$(commandeId)/tarification/prix).data.montantLivraison == request.resource.data.montantLivraisonBoutique
      ) || (estConnecte()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.keys().hasAll([
          "clientId", "service", "depart", "destination", "statut", "createdAt", "publicVersion"
        ])
        && request.resource.data.keys().hasOnly([
          "clientId", "service", "depart", "destination", "statut", "createdAt",
          "dateHeureSouhaitee", "publicVersion"
        ])
        && (request.resource.data['service'] == "compagnie"
          || request.resource.data['service'] == "livraison"
          || request.resource.data['service'] == "livraison_programmee")
        && request.resource.data.statut == "en_attente"
        && request.resource.data.publicVersion == true
        && request.resource.data.createdAt == request.time
        && existsAfter(detailsPrivesPath(commandeId))
        && getAfter(detailsPrivesPath(commandeId)).data.clientId == request.auth.uid
        && (
          request.resource.data['service'] != "livraison_programmee"
          || (request.resource.data.dateHeureSouhaitee is timestamp
            && request.resource.data.dateHeureSouhaitee >= request.time + duration.value(1, "h")
            && request.resource.data.dateHeureSouhaitee <= request.time + duration.value(1, "d"))
        ));

      allow read: if estAdmin()
        || (estConnecte() && resource.data.clientId == request.auth.uid)
        || (estConnecte() && resource.data.partenaireId == request.auth.uid)
        || (estConnecte() && resource.data.boutiqueUid == request.auth.uid)
        || (resource.data.publicVersion == true
          && resource.data.statut == "en_attente"
          && !contientChampsPrives(resource.data)
          && partenaireEnLignePour(resource.data['service']));

      // Acceptation ou attribution : l'ordre et le verrou doivent être écrits dans la même transaction.
      allow update: if (
          estAdmin()
          && resource.data.publicVersion == true
          && resource.data.statut == "en_attente"
          && request.resource.data.statut == "livreur_affecte"
          && request.resource.data.partenaireId is string
          && ((resource.data['service'] == "compagnie" && request.resource.data.partenaireType == "representant_gare" && partenaire(request.resource.data.partenaireId).type == "representant_gare") || (resource.data['service'] != "compagnie" && request.resource.data.partenaireType == "livreur_independant" && partenaire(request.resource.data.partenaireId).type == "livreur_independant"))
          && request.resource.data.dateAffectation == request.time
          && request.resource.data.affectePar == request.auth.uid
          && partenaire(request.resource.data.partenaireId).enLigne == true
          && abonnementValide(partenaire(request.resource.data.partenaireId))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["partenaireId", "partenaireNom", "partenaireType", "dateAffectation", "affectePar", "statut"])
          && existsAfter(verrouPath(request.resource.data.partenaireId))
          && getAfter(verrouPath(request.resource.data.partenaireId)).data.commandeId == commandeId
        )
        || (
          estConnecte()
          && resource.data.publicVersion == true
          && resource.data.statut == "en_attente"
          && !("partenaireId" in resource.data)
          && request.resource.data.partenaireId == request.auth.uid
          && request.resource.data.statut == "livreur_affecte"
          && request.resource.data.dateAffectation == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["partenaireId", "partenaireNom", "partenaireTelephone", "partenairePhotoProfil", "partenaireType", "dateAffectation", "statut"])
          && existsAfter(verrouPath(request.auth.uid))
          && getAfter(verrouPath(request.auth.uid)).data.commandeId == commandeId
          && partenaireEnLignePour(resource.data['service'])
        )
        || (
          estConnecte()
          && resource.data.typeCommande == "boutique"
          && resource.data.boutiqueUid == request.auth.uid
          && resource.data.statut == "commande_boutique"
          && request.resource.data.statut == "en_attente"
          && request.resource.data.publicVersion == true
          && request.resource.data.dateMiseEnLivraison == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["statut","publicVersion","dateMiseEnLivraison"])
        )
        || (
          estConnecte()
          && resource.data.partenaireId == request.auth.uid
          && resource.data.statut == "livreur_affecte"
          && request.resource.data.statut == "en_attente"
          && !("partenaireId" in request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["partenaireId", "partenaireNom", "partenaireType", "dateAffectation", "affectePar", "statut"])
        )
        || (
          estConnecte()
          && resource.data.partenaireId == request.auth.uid
          && resource.data.statut == "livreur_affecte"
          && request.resource.data.statut == "colis_recupere"
          && request.resource.data.dateRecuperation == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["statut", "dateRecuperation"])
          && exists(verrouPath(request.auth.uid))
          && get(verrouPath(request.auth.uid)).data.commandeId == commandeId
          && get(verrouPath(request.auth.uid)).data.statut == "active"
        )
        || (
          estConnecte()
          && resource.data.partenaireId == request.auth.uid
          && (resource.data.statut == "colis_recupere" || resource.data.statut == "en_transit")
          && request.resource.data.statut == "arrive_destination"
          && request.resource.data.dateArriveeDestination == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["statut", "dateArriveeDestination"])
          && exists(verrouPath(request.auth.uid))
          && get(verrouPath(request.auth.uid)).data.commandeId == commandeId
          && get(verrouPath(request.auth.uid)).data.statut == "active"
        )
        || (
          estConnecte()
          && resource.data.partenaireId == request.auth.uid
          && resource.data.statut == "arrive_destination"
          && request.resource.data.statut == "livre"
          && request.resource.data.dateLivraison == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["statut", "dateLivraison"])
          && exists(verrouPath(request.auth.uid))
          && get(verrouPath(request.auth.uid)).data.commandeId == commandeId
          && get(verrouPath(request.auth.uid)).data.statut == "active"
          && exists(/databases/$(database)/documents/commandes_colis/$(commandeId)/tarification/prix)
          && (
            resource.data['service'] != "compagnie"
            || get(/databases/$(database)/documents/commandes_colis/$(commandeId)/informations_privees/details).data.get("operation", null) != "expedition"
            || existsAfter(/databases/$(database)/documents/commandes_colis/$(commandeId)/informations_privees/expedition)
          )
        )
        // Migration administrative contrôlée des anciennes commandes vers le document privé.
        || (
          estAdmin()
          && request.resource.data.publicVersion == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "clientNom", "clientTelephone", "telephoneExpediteur", "telephoneDestinataire",
            "adresseRecuperation", "adresseLivraison", "descriptionColis", "trackingNumber",
            "provenance", "codeColis", "typeColis", "livreurId", "operation", "compagnie",
            "gare", "latitudeRecuperation", "longitudeRecuperation",
            "latitudeLivraison", "longitudeLivraison", "publicVersion"
          ])
          && !contientChampsPrives(request.resource.data)
          && (
            (existsAfter(detailsPrivesPath(commandeId))
              && getAfter(detailsPrivesPath(commandeId)).data.clientId == resource.data.clientId
              && getAfter(detailsPrivesPath(commandeId)).data.trackingNumber is string
              && (!(resource.data.get("trackingNumber", null) is string)
                || getAfter(detailsPrivesPath(commandeId)).data.trackingNumber == resource.data.trackingNumber))
            || (!existsAfter(detailsPrivesPath(commandeId))
              && !contientChampsPrives(resource.data))
          )
        )
        || (
          estConnecte()
          && resource.data.partenaireId == request.auth.uid
          && resource.data.statut in ["livreur_affecte", "colis_recupere", "en_transit", "arrive_destination"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["positionLivreur", "positionLivreurMaj"])
          && request.resource.data.positionLivreur is map
          && request.resource.data.positionLivreur.keys().hasAll(["latitude", "longitude"])
          && request.resource.data.positionLivreur.latitude is number
          && request.resource.data.positionLivreur.latitude >= -90
          && request.resource.data.positionLivreur.latitude <= 90
          && request.resource.data.positionLivreur.longitude is number
          && request.resource.data.positionLivreur.longitude >= -180
          && request.resource.data.positionLivreur.longitude <= 180
          && request.resource.data.positionLivreurMaj == request.time
        );

      allow delete: if estAdmin();

      match /informations_privees/{docId} {
        allow create: if (docId == "details"
          && request.resource.data.keys().hasAll([
            "clientId", "clientNom", "clientTelephone", "telephoneExpediteur",
            "telephoneDestinataire", "adresseRecuperation", "adresseLivraison",
            "descriptionColis", "trackingNumber", "createdAt"
          ])
          && request.resource.data.keys().hasOnly([
            "clientId", "clientNom", "clientTelephone", "telephoneExpediteur",
            "telephoneDestinataire", "adresseRecuperation", "descriptionColis",
            "adresseLivraison", "trackingNumber", "provenance", "codeColis",
            "operation", "compagnie", "gare", "expeditionPayee", "latitudeRecuperation",
            "longitudeRecuperation", "latitudeLivraison", "longitudeLivraison",
            "typeColis", "livreurId", "createdAt",
            "produitCommande", "quantiteCommande", "prixProduit", "commentaireCommande",
            "boutiqueUid", "telephoneBoutique", "telephoneClient"
          ])
          && request.resource.data.createdAt == request.time
          && (
            (estConnecte()
              && !exists(commandePath(commandeId))
              && getAfter(commandePath(commandeId)).data.clientId == request.auth.uid
              && (getAfter(commandePath(commandeId)).data.statut == "en_attente"
                || (getAfter(commandePath(commandeId)).data.typeCommande == "boutique"
                  && getAfter(commandePath(commandeId)).data.statut == "commande_boutique"))
              && request.resource.data.clientId == request.auth.uid)
            || (estAdmin()
              && get(commandePath(commandeId)).data.clientId == request.resource.data.clientId)
          ))
          || (docId == "expedition"
            && estConnecte()
            && get(commandePath(commandeId)).data.partenaireId == request.auth.uid
            && get(commandePath(commandeId)).data.statut == "arrive_destination"
            && request.resource.data.keys().hasAll(["compagnieExpedition","gareDestination","codeColis","partenaireId","createdAt"])
            && request.resource.data.keys().hasOnly(["compagnieExpedition","gareDestination","codeColis","partenaireId","createdAt"])
            && request.resource.data.partenaireId == request.auth.uid
            && request.resource.data.compagnieExpedition is string
            && request.resource.data.gareDestination is string
            && request.resource.data.codeColis is string
            && request.resource.data.createdAt == request.time);

        allow read: if estAdmin()
          || (estConnecte()
            && get(commandePath(commandeId)).data.clientId == request.auth.uid)
          || (estConnecte()
            && get(commandePath(commandeId)).data.partenaireId == request.auth.uid)
          || (estConnecte()
            && get(commandePath(commandeId)).data.boutiqueUid == request.auth.uid);

        allow update, delete: if estAdmin();
      }

      match /tarification/{docId} {
        allow create: if docId == "prix"
          && estConnecte()
          && !exists(commandePath(commandeId))
          && getAfter(commandePath(commandeId)).data.clientId == request.auth.uid
          && (getAfter(commandePath(commandeId)).data.statut == "en_attente"
            || (getAfter(commandePath(commandeId)).data.typeCommande == "boutique"
              && getAfter(commandePath(commandeId)).data.statut == "commande_boutique"))
          && request.resource.data.keys().hasAll(["distanceKm","distanceMetres","tarifKm","montantLivraison","fraisService","montantTotal","devise","operation","createdAt"])
          && request.resource.data.keys().hasOnly(["distanceKm","distanceMetres","tarifKm","montantLivraison","fraisService","montantTotal","devise","operation","createdAt"])
          && request.resource.data.distanceKm is number
          && request.resource.data.distanceMetres is number
          && request.resource.data.tarifKm in [100,120,150,190]
          && request.resource.data.montantLivraison is int
          && request.resource.data.fraisService in [0,300]
          && request.resource.data.montantTotal == request.resource.data.montantLivraison + request.resource.data.fraisService
          && (getAfter(commandePath(commandeId)).data.get("typeCommande", null) != "boutique"
            || (request.resource.data.distanceKm == 0
              && request.resource.data.distanceMetres == 0
              && request.resource.data.fraisService == 0
              && request.resource.data.montantLivraison == getAfter(commandePath(commandeId)).data.montantLivraisonBoutique
              && request.resource.data.montantTotal == getAfter(commandePath(commandeId)).data.montantLivraisonBoutique))
          && request.resource.data.devise == "FCFA"
          && request.resource.data.createdAt == request.time;
        allow read: if estAdmin()
          || (estConnecte()
            && get(commandePath(commandeId)).data.clientId == request.auth.uid)
          || (estConnecte()
            && get(commandePath(commandeId)).data.partenaireId == request.auth.uid
            && (get(commandePath(commandeId)).data.statut == "arrive_destination"
              || get(commandePath(commandeId)).data.statut == "livre"));
        allow update, delete: if estAdmin();
      }

    }


    // Service de cars de ramassage : profils, offres publiques et demandes privées.
    function compagnieRamassageActive(uid) {
      return exists(/databases/$(database)/documents/comptes_ramassage/$(uid))
        && get(/databases/$(database)/documents/comptes_ramassage/$(uid)).data.role == "compagnie"
        && get(/databases/$(database)/documents/comptes_ramassage/$(uid)).data.statut == "approuve"
        && get(/databases/$(database)/documents/comptes_ramassage/$(uid)).data.abonnement == "actif"
        && get(/databases/$(database)/documents/comptes_ramassage/$(uid)).data.dateExpirationAbonnement is timestamp
        && get(/databases/$(database)/documents/comptes_ramassage/$(uid)).data.dateExpirationAbonnement > request.time;
    }

    match /comptes_ramassage/{uid} {
      allow create: if estConnecte()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasAll(["uid","role","nom","telephone","email","statut","abonnement","createdAt"])
        && request.resource.data.keys().hasOnly(["uid","role","nom","telephone","email","statut","abonnement","createdAt"])
        && (request.resource.data.role == "usager"
          ? request.resource.data.statut == "actif" && request.resource.data.abonnement == "non_applicable"
          : request.resource.data.role == "compagnie"
            && request.resource.data.statut == "en_attente"
            && request.resource.data.abonnement == "inactif")
        && request.resource.data.createdAt == request.time;
      allow read: if estAdmin() || (estConnecte() && request.auth.uid == uid);
      allow update, delete: if estAdmin();
    }

    match /offres_ramassage/{offreId} {
      allow read: if resource.data.statut == "publiee";
      allow create: if estConnecte()
        && request.resource.data.compagnieId == request.auth.uid
        && compagnieRamassageActive(request.auth.uid)
        && request.resource.data.keys().hasAll([
          "compagnieId","compagnieNom","telephone","communeDepart","points","destination",
          "jours","heure","placesDisponibles","tarif","statut","createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "compagnieId","compagnieNom","telephone","communeDepart","points","destination",
          "jours","heure","placesDisponibles","tarif","statut","createdAt"
        ])
        && request.resource.data.statut == "publiee"
        && request.resource.data.placesDisponibles is int
        && request.resource.data.placesDisponibles > 0
        && request.resource.data.createdAt == request.time;
      allow update, delete: if estAdmin();
    }

    match /demandes_ramassage/{demandeId} {
      allow create: if estConnecte()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll([
          "userId","communeDepart","pointDepart","destination","jours",
          "heure","places","statut","createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "userId","communeDepart","pointDepart","destination","jours",
          "heure","places","statut","createdAt"
        ])
        && request.resource.data.statut == "ouverte"
        && request.resource.data.places is int
        && request.resource.data.places > 0
        && request.resource.data.places <= 10
        && request.resource.data.createdAt == request.time;
      allow read: if estAdmin()
        || (estConnecte() && resource.data.userId == request.auth.uid)
        || (estConnecte() && compagnieRamassageActive(request.auth.uid));
      allow update, delete: if estAdmin();
    }

    match /demandes_publicites/{demandeId} {
      allow create: if request.resource.data.keys().hasAll([
          "nom","telephone","activite","description","forfait","forfaitTexte",
          "dureeJours","montantFCFA","statut","createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "nom","telephone","activite","description","forfait","forfaitTexte",
          "dureeJours","montantFCFA","statut","createdAt"
        ])
        && request.resource.data.nom is string
        && request.resource.data.nom.size() > 0
        && request.resource.data.nom.size() <= 80
        && request.resource.data.telephone is string
        && request.resource.data.telephone.size() >= 8
        && request.resource.data.telephone.size() <= 20
        && request.resource.data.activite is string
        && request.resource.data.activite.size() > 0
        && request.resource.data.activite.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 1000
        && request.resource.data.statut == "en_attente"
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.forfait == "Découverte"
            && request.resource.data.dureeJours == 3
            && request.resource.data.montantFCFA == 2000)
          || (request.resource.data.forfait == "Visibilité"
            && request.resource.data.dureeJours == 7
            && request.resource.data.montantFCFA == 5000)
          || (request.resource.data.forfait == "Professionnel"
            && request.resource.data.dureeJours == 15
            && request.resource.data.montantFCFA == 9000)
          || (request.resource.data.forfait == "Premium"
            && request.resource.data.dureeJours == 30
            && request.resource.data.montantFCFA == 15000)
        );
      allow read, update, delete: if estAdmin();
    }

    match /abonnements_petites_annonces/{uid} {
      allow read: if estAdmin() || (estConnecte() && request.auth.uid == uid);
      allow create: if estConnecte() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(["uid","email","statut","essaiGratuitUtilise","dateDebut","dateExpiration","paiementStatut","createdAt"])
        && request.resource.data.statut == "actif"
        && request.resource.data.essaiGratuitUtilise == true
        && request.resource.data.paiementStatut == "gratuit"
        && request.resource.data.dateDebut == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.dateExpiration is timestamp
        && abonnementAutorise("petites_annonces")
        && abonnementChamp("petites_annonces", "essai", 30) > 0
        && request.resource.data.dateExpiration >= request.time + duration.value(abonnementChamp("petites_annonces", "essai", 30) - 1, "d")
        && request.resource.data.dateExpiration <= request.time + duration.value(abonnementChamp("petites_annonces", "essai", 30) + 1, "d");
      allow update: if estAdmin()
        || (estConnecte() && request.auth.uid == uid
          && resource.data.dateExpiration is timestamp
          && resource.data.dateExpiration <= request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paiementMoyen","paiementReference","montantRenouvellement","dureeRenouvellementJours","paiementStatut","demandeRenouvellementLe"])
          && request.resource.data.paiementMoyen in ["Wave","Orange Money"]
          && request.resource.data.paiementReference is string
          && request.resource.data.paiementReference.size() >= 4
          && request.resource.data.paiementReference.size() <= 80
          && abonnementAutorise("petites_annonces")
          && request.resource.data.montantRenouvellement is int
          && request.resource.data.montantRenouvellement > 0
          && request.resource.data.montantRenouvellement <= abonnementChamp("petites_annonces", "prix", 500)
          && request.resource.data.dureeRenouvellementJours == dureeEnJours("petites_annonces", 30)
          && request.resource.data.paiementStatut == "a_verifier"
          && request.resource.data.demandeRenouvellementLe == request.time);
      allow delete: if estAdmin();
    }

    match /demandes_nouveaux_services/{demandeId} {
      allow create: if estConnecte()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(["uid","type","titre","categorie","commune","telephone","description","email","statut","createdAt"])
        && request.resource.data.keys().hasOnly(["uid","type","titre","categorie","commune","telephone","description","email","photoUrl","produits","adresseBoutique","tarifLivraisonBoutique","paiementMoyen","paiementReference","montantAbonnement","dureeAbonnementJours","paiementStatut","modePartenaire","rubrique","quartier","statut","createdAt"])
        && request.resource.data.type in ["depannage","commerce","annonce","annuaire"]
        && (request.resource.data.type != "annuaire"
          || (request.resource.data.rubrique in ["educationFormation","logementImmobilier","depannageDomicile","agricultureElevage","evenementsPrestations","artisansProfessionnels"]
            && request.resource.data.quartier is string
            && request.resource.data.quartier.size() <= 120
            && request.resource.data.categorie in ["École","Université","Centre de formation","Cours particuliers","Agence immobilière","Location de logement","Promoteur immobilier","Gestion locative","Plomberie","Électricité","Climatisation","Réparation électroménager","Nettoyage","Producteur agricole","Fournisseur agricole","Élevage","Matériel agricole","Traiteur","Salle de réception","Photographe","Décoration","Location de matériel","Couturier","Menuisier","Soudeur","Mécanicien","Coiffeur","Autre artisan"]))
        && (!request.resource.data.keys().hasAny(["modePartenaire"]) || request.resource.data.get("modePartenaire", false) == true)
        && (request.resource.data.type != "commerce"
          || (request.resource.data.modePartenaire == true
            && request.resource.data.categorie in ["Pièces détachées","Autre commerce"])
          || (request.resource.data.produits is list
            && request.resource.data.produits.size() > 0
            && request.resource.data.adresseBoutique is string
            && request.resource.data.adresseBoutique.size() > 4
            && request.resource.data.adresseBoutique.size() <= 220
            && request.resource.data.tarifLivraisonBoutique in [1000,1500,2000,2500]
            && request.resource.data.paiementMoyen in ["Wave","Orange Money"]
            && request.resource.data.paiementReference is string
            && request.resource.data.paiementReference.size() >= 4
            && request.resource.data.paiementReference.size() <= 80
            && request.resource.data.montantAbonnement is int
              && request.resource.data.montantAbonnement > 0
              && (
                (abonnementAutorise("boutiques_15j")
                  && request.resource.data.montantAbonnement <= abonnementChamp("boutiques_15j", "prix", 4000)
                  && request.resource.data.dureeAbonnementJours == dureeEnJours("boutiques_15j", 15))
                ||
                (abonnementAutorise("boutiques_30j")
                  && request.resource.data.montantAbonnement <= abonnementChamp("boutiques_30j", "prix", 7000)
                  && request.resource.data.dureeAbonnementJours == dureeEnJours("boutiques_30j", 30))
              )
            && request.resource.data.paiementStatut == "a_verifier"))
        && request.resource.data.titre is string && request.resource.data.titre.size() > 0 && request.resource.data.titre.size() <= 100
        && request.resource.data.categorie is string && request.resource.data.categorie.size() <= 80
        && request.resource.data.commune is string && request.resource.data.commune.size() > 0 && request.resource.data.commune.size() <= 60
        && request.resource.data.telephone is string && request.resource.data.telephone.size() >= 8 && request.resource.data.telephone.size() <= 20
        && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 1200
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && (!request.resource.data.keys().hasAny(["photoUrl"]) || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 400000 && request.resource.data.photoUrl.matches("^data:image/jpeg;base64,.*$")))
        && (request.resource.data.type != "annonce"
          || (existsAfter(/databases/$(database)/documents/abonnements_petites_annonces/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/abonnements_petites_annonces/$(request.auth.uid)).data.dateExpiration is timestamp
            && getAfter(/databases/$(database)/documents/abonnements_petites_annonces/$(request.auth.uid)).data.dateExpiration > request.time))
        && request.resource.data.statut == "en_attente"
        && request.resource.data.createdAt == request.time;
      allow read: if estAdmin() || (resource.data.statut == "approuve" && (resource.data.type != "depannage" || estAbonneAutomobiliste()) && (resource.data.type != "annuaire" || (resource.data.abonnementFin is timestamp && resource.data.abonnementFin > request.time)));
      allow update, delete: if estAdmin();
    }

    match /avis_boutiques/{avisId} {
      allow create: if request.resource.data.keys().hasAll([
          "boutiqueId","boutiqueUid","nom","produit","commentaire",
          "satisfaction","achatDeclare","createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "boutiqueId","boutiqueUid","nom","produit","commentaire",
          "satisfaction","achatDeclare","createdAt"
        ])
        && request.resource.data.boutiqueId is string
        && exists(/databases/$(database)/documents/demandes_nouveaux_services/$(request.resource.data.boutiqueId))
        && get(/databases/$(database)/documents/demandes_nouveaux_services/$(request.resource.data.boutiqueId)).data.type == "commerce"
        && get(/databases/$(database)/documents/demandes_nouveaux_services/$(request.resource.data.boutiqueId)).data.uid == request.resource.data.boutiqueUid
        && get(/databases/$(database)/documents/demandes_nouveaux_services/$(request.resource.data.boutiqueId)).data.statut == "approuve"
        && get(/databases/$(database)/documents/demandes_nouveaux_services/$(request.resource.data.boutiqueId)).data.abonnementFin is timestamp
        && get(/databases/$(database)/documents/demandes_nouveaux_services/$(request.resource.data.boutiqueId)).data.abonnementFin > request.time
        && request.resource.data.nom is string
        && request.resource.data.nom.size() > 0
        && request.resource.data.nom.size() <= 80
        && request.resource.data.produit is string
        && request.resource.data.produit.size() > 0
        && request.resource.data.produit.size() <= 100
        && request.resource.data.commentaire is string
        && request.resource.data.commentaire.size() > 0
        && request.resource.data.commentaire.size() <= 700
        && request.resource.data.satisfaction in ["satisfait","mitige","insatisfait"]
        && request.resource.data.achatDeclare == true
        && request.resource.data.createdAt == request.time;
      allow read: if estAdmin()
        || (estConnecte() && resource.data.boutiqueUid == request.auth.uid);
      allow update, delete: if estAdmin();
    }

    match /publicites/{publiciteId} {
      allow read: if estAdmin() || resource.data.statut == "publiee";
      allow create, update, delete: if estAdmin();
    }

    match /demandes_abonnement_automobiliste/{demandeId} {
      allow create: if estConnecte()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(["uid","email","operateur","referencePaiement","nomPayeur","montantFCFA","dureeMois","statut","createdAt"])
        && request.resource.data.keys().hasOnly(["uid","email","operateur","referencePaiement","nomPayeur","montantFCFA","dureeMois","statut","createdAt"])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.operateur in ["Wave","Orange Money"]
        && request.resource.data.referencePaiement is string
        && request.resource.data.referencePaiement.size() >= 4
        && request.resource.data.referencePaiement.size() <= 80
        && request.resource.data.nomPayeur is string
        && request.resource.data.nomPayeur.size() <= 80
        && abonnementAutorise("automobiliste")
        && request.resource.data.montantFCFA is int
        && request.resource.data.montantFCFA > 0
        && request.resource.data.montantFCFA <= abonnementChamp("automobiliste", "prix", 1000)
        && request.resource.data.dureeMois == abonnementChamp("automobiliste", "duree", 12)
        && request.resource.data.statut == "en_attente"
        && request.resource.data.createdAt == request.time;
      allow read: if estAdmin() || (estConnecte() && resource.data.uid == request.auth.uid);
      allow update, delete: if estAdmin();
    }

    match /abonnements_automobiliste/{uid} {
      allow read: if estAdmin() || (estConnecte() && request.auth.uid == uid);
      allow create, update, delete: if estAdmin();
    }

    match /configuration_application/{configId} {
      allow read: if true;
      allow create, update, delete: if estAdmin();
    }


    match /annonceurs/{uid} {
      allow create: if estConnecte() && request.auth.uid == uid && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(["uid","nom","telephone","email","createdAt"])
        && request.resource.data.nom is string && request.resource.data.nom.size() >= 2
        && request.resource.data.telephone is string && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow read: if estAdmin() || (estConnecte() && request.auth.uid == uid);
      allow update: if estAdmin() || (estConnecte() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nom","telephone"]));
      allow delete: if estAdmin();
    }
    // Offres d'emploi : soumissions utilisateurs en attente ; validation par l'administrateur.
    match /annonces_offres/{id} {
      allow create: if estConnecte()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(["uid","titre","entreprise","categorie","commune","telephone","description","typeAnnonce","statut","createdAt"])
        && request.resource.data.keys().hasOnly(["uid","titre","entreprise","categorie","commune","telephone","description","typeAnnonce","statut","createdAt","annonceurNom","paiementMoyen","referencePaiement","montantFCFA","dureeJours","paiementStatut"])
        && request.resource.data.typeAnnonce == "emploi"
        && request.resource.data.titre is string && request.resource.data.titre.size() >= 3 && request.resource.data.titre.size() <= 120
        && request.resource.data.entreprise is string && request.resource.data.entreprise.size() >= 2 && request.resource.data.entreprise.size() <= 120
        && request.resource.data.categorie in ["Emploi","Stage","Formation","Appel à candidatures","Autre opportunité"]
        && request.resource.data.commune is string && request.resource.data.commune.size() >= 2 && request.resource.data.commune.size() <= 80
        && request.resource.data.telephone is string && request.resource.data.telephone.size() >= 6 && request.resource.data.telephone.size() <= 25
        && request.resource.data.description is string && request.resource.data.description.size() >= 20 && request.resource.data.description.size() <= 1800
        && request.resource.data.createdAt == request.time
        && (request.resource.data.statut == "en_attente" || (estAdmin() && request.resource.data.statut == "publiee"));
      allow read: if estAdmin() || resource.data.statut == "publiee" || (estConnecte() && resource.data.uid == request.auth.uid);
      allow update: if estAdmin() && resource.data.typeAnnonce == "emploi"
        && resource.data.statut == "en_attente" && request.resource.data.statut == "publiee"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["statut","valideePar","dateValidation"])
        && request.resource.data.valideePar == request.auth.uid && request.resource.data.dateValidation == request.time;
      allow delete: if estAdmin();
    }
    match /informations_admin/{id} {
      allow read: if estAdmin() || resource.data.statut == "publiee";
      allow create: if estAdmin() && request.resource.data.keys().hasOnly(["message","statut","publieLe","createdBy"])
        && request.resource.data.message is string && request.resource.data.message.size() >= 3 && request.resource.data.message.size() <= 1500
        && request.resource.data.statut == "publiee" && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if estAdmin();
    }
    match /gbairai_profils/{uid} {
      allow create: if estConnecte() && request.auth.uid == uid && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(["uid","pseudonyme","gratuitRestant","bonusRestant","resetAt","createdAt"])
        && request.resource.data.pseudonyme is string && request.resource.data.pseudonyme.size() >= 2 && request.resource.data.pseudonyme.size() <= 24
        && request.resource.data.gratuitRestant == 15 && request.resource.data.bonusRestant == 0
        && (request.resource.data.resetAt == null || request.resource.data.resetAt is timestamp) && request.resource.data.createdAt == request.time;
      allow read: if estAdmin() || (estConnecte() && request.auth.uid == uid);
      allow update: if estAdmin() || (estConnecte() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["gratuitRestant","bonusRestant","resetAt","lastMessageId","lastSentAt"])
        && request.resource.data.lastMessageId is string
        && getAfter(/databases/$(database)/documents/gbairai_messages/$(request.resource.data.lastMessageId)).data.senderUid == uid
        && ((request.resource.data.gratuitRestant == resource.data.gratuitRestant - 1 && request.resource.data.bonusRestant == resource.data.bonusRestant)
          || (request.resource.data.bonusRestant == resource.data.bonusRestant - 1 && request.resource.data.gratuitRestant == resource.data.gratuitRestant)
          || (resource.data.resetAt is timestamp && resource.data.resetAt <= request.time
            && request.resource.data.gratuitRestant in [14,15]
            && request.resource.data.resetAt == null
            && request.resource.data.bonusRestant in [resource.data.bonusRestant,resource.data.bonusRestant - 1])
          || (resource.data.gratuitRestant == 1 && request.resource.data.gratuitRestant == 0
            && request.resource.data.bonusRestant == resource.data.bonusRestant
            && request.resource.data.resetAt is timestamp && request.resource.data.resetAt > request.time)));
      allow delete: if estAdmin();
    }
    match /gbairai_messages/{id} {
      allow read: if true;
      allow create: if estConnecte() && request.resource.data.keys().hasOnly(["senderUid","pseudonyme","texte","createdAt","expiresAt"])
        && request.resource.data.senderUid == request.auth.uid && request.resource.data.pseudonyme is string
        && request.resource.data.texte is string && request.resource.data.texte.size() >= 1 && request.resource.data.texte.size() <= 500
        && request.resource.data.createdAt == request.time && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
        && existsAfter(/databases/$(database)/documents/gbairai_profils/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/gbairai_profils/$(request.auth.uid)).data.lastMessageId == id;
      allow update: if false;
      allow delete: if estAdmin();
    }
    match /gbairai_recharges/{id} {
      allow create: if estConnecte() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["uid","pseudonyme","operateur","referencePaiement","montantFCFA","messages","statut","createdAt"])
        && request.resource.data.operateur in ["Wave","Orange Money"] && request.resource.data.referencePaiement is string
        && request.resource.data.referencePaiement.size() >= 4 && request.resource.data.montantFCFA == 100
        && request.resource.data.messages == 15 && request.resource.data.statut == "en_attente" && request.resource.data.createdAt == request.time;
      allow read: if estAdmin() || (estConnecte() && resource.data.uid == request.auth.uid);
      allow update, delete: if estAdmin();
    }


    // Déclarations publiques : seuls les champs non sensibles sont stockés ici.
    match /objets_retrouves/{objetId} {
      allow read: if estAdmin() || resource.data.statut == "publie";
      allow create: if request.resource.data.keys().hasOnly(["type","description","lieu","statut","createdAt"])
        && request.resource.data.keys().hasAll(["type","description","lieu","statut","createdAt"])
        && request.resource.data.type in ["Objet","Document"]
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 1
        && request.resource.data.description.size() <= 500
        && request.resource.data.lieu is string
        && request.resource.data.lieu.size() >= 1
        && request.resource.data.lieu.size() <= 180
        && request.resource.data.statut == "en_attente"
        && request.resource.data.createdAt == request.time;
      allow update, delete: if estAdmin();
    }

    // Coordonnées du trouveur et identité du document : administrateur uniquement.
    match /objets_retrouves_prives/{objetId} {
      allow create: if request.resource.data.keys().hasOnly(["objetId","trouveurNom","trouveurTelephone","nomDocument","createdAt"])
        && request.resource.data.keys().hasAll(["objetId","trouveurNom","trouveurTelephone","nomDocument","createdAt"])
        && request.resource.data.objetId == objetId
        && request.resource.data.trouveurNom is string
        && request.resource.data.trouveurNom.size() >= 2
        && request.resource.data.trouveurNom.size() <= 100
        && request.resource.data.trouveurTelephone is string
        && request.resource.data.trouveurTelephone.size() >= 6
        && request.resource.data.trouveurTelephone.size() <= 25
        && request.resource.data.nomDocument is string
        && request.resource.data.nomDocument.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if estAdmin();
    }

    // Coordonnées du demandeur et références de paiement : aucun accès public en lecture.
    match /demandes_recuperation_objets/{demandeId} {
      allow create: if request.resource.data.keys().hasOnly([
          "objetId","nomComplet","telephone","residence","operateur",
          "referenceTransaction","heureTransaction","montantFCFA","statut","createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "objetId","nomComplet","telephone","residence","operateur",
          "referenceTransaction","heureTransaction","montantFCFA","statut","createdAt"
        ])
        && request.resource.data.objetId is string
        && exists(/databases/$(database)/documents/objets_retrouves/$(request.resource.data.objetId))
        && get(/databases/$(database)/documents/objets_retrouves/$(request.resource.data.objetId)).data.statut == "publie"
        && request.resource.data.nomComplet is string
        && request.resource.data.nomComplet.size() >= 2
        && request.resource.data.nomComplet.size() <= 100
        && request.resource.data.telephone is string
        && request.resource.data.telephone.size() >= 6
        && request.resource.data.telephone.size() <= 25
        && request.resource.data.residence is string
        && request.resource.data.residence.size() >= 2
        && request.resource.data.residence.size() <= 180
        && request.resource.data.operateur in ["Wave","Orange Money"]
        && request.resource.data.referenceTransaction is string
        && request.resource.data.referenceTransaction.size() >= 4
        && request.resource.data.referenceTransaction.size() <= 100
        && request.resource.data.heureTransaction is string
        && request.resource.data.heureTransaction.size() >= 10
        && request.resource.data.heureTransaction.size() <= 40
        && request.resource.data.montantFCFA == 1500
        && request.resource.data.statut == "a_verifier"
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if estAdmin();
    }

    // Répertoire public des supermarchés importés depuis OpenStreetMap.
    // Seul l'administrateur peut importer, corriger ou supprimer les fiches.
    match /supermarches/{supermarcheId} {
      allow read: if true;
      allow create, update, delete: if estAdmin();
    }


    // Dons et solidarité : seules les publications approuvées sont visibles publiquement.
    // Les coordonnées personnelles sont conservées dans une sous-collection privée.
    match /dons_solidarite/{dossierId} {
      allow create: if estConnecte()
        && request.resource.data.keys().hasAll(["uid","type","titre","categorie","commune","description","statut","createdAt"])
        && request.resource.data.keys().hasOnly(["uid","type","titre","categorie","commune","description","statut","createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ["don","besoin"]
        && request.resource.data.titre is string
        && request.resource.data.titre.size() >= 2
        && request.resource.data.titre.size() <= 100
        && request.resource.data.categorie is string
        && request.resource.data.categorie.size() <= 80
        && request.resource.data.commune is string
        && request.resource.data.commune.size() >= 2
        && request.resource.data.commune.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 2
        && request.resource.data.description.size() <= 1000
        && request.resource.data.statut == "en_attente"
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/dons_solidarite/$(dossierId)/informations_privees/contact)
        && getAfter(/databases/$(database)/documents/dons_solidarite/$(dossierId)/informations_privees/contact).data.uid == request.auth.uid;
      allow read: if estAdmin() || resource.data.statut == "approuve";
      allow update, delete: if estAdmin();

      match /informations_privees/{contactId} {
        allow create: if estConnecte()
          && contactId == "contact"
          && request.resource.data.keys().hasAll(["uid","nom","telephone","email","createdAt"])
          && request.resource.data.keys().hasOnly(["uid","nom","telephone","email","createdAt"])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nom is string
          && request.resource.data.nom.size() >= 2
          && request.resource.data.nom.size() <= 100
          && request.resource.data.telephone is string
          && request.resource.data.telephone.size() >= 6
          && request.resource.data.telephone.size() <= 20
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 120
          && request.resource.data.createdAt == request.time
          && existsAfter(/databases/$(database)/documents/dons_solidarite/$(dossierId))
          && getAfter(/databases/$(database)/documents/dons_solidarite/$(dossierId)).data.uid == request.auth.uid;
        allow read: if estAdmin();
        allow update, delete: if estAdmin();
      }
    }

    // Répertoire de proximité : lecture publique, gestion réservée à l'administrateur.
    match /services_proximite/{serviceId} {
      allow read: if true;
      allow create, update, delete: if estAdmin();
    }

    match /demandes_foncieres_privees/{demandeId} {
      allow create: if estConnecte()
        && request.resource.data.keys().hasAll(["uid","email","nom","telephone","typeDemande","question","refs","statut","reponseAdmin","createdAt","updatedAt"])
        && request.resource.data.keys().hasOnly(["uid","email","nom","telephone","typeDemande","question","refs","statut","reponseAdmin","createdAt","updatedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nom is string && request.resource.data.nom.size() >= 2 && request.resource.data.nom.size() <= 100
        && request.resource.data.telephone is string && request.resource.data.telephone.size() >= 6 && request.resource.data.telephone.size() <= 25
        && request.resource.data.typeDemande in ["verification_lotissement","verification_parcelle","comprendre_document","suivi_demande"]
        && request.resource.data.question is string && request.resource.data.question.size() >= 5 && request.resource.data.question.size() <= 1200
        && request.resource.data.refs is map && request.resource.data.refs.keys().hasOnly(["localite","lotissement","ilot","lot","idufci"])
        && request.resource.data.statut == "reçue" && request.resource.data.reponseAdmin == ""
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow read: if estAdmin() || (estConnecte() && resource.data.uid == request.auth.uid);
      allow update, delete: if estAdmin();
    }


    // Ma commune en direct : lecture publique des seules publications visibles, écriture administrateur.
    match /actualites_communes/{actualiteId} {
      allow read: if estAdmin() || resource.data.statut == "publiee";
      allow create: if estAdmin()
        && request.resource.data.keys().hasAll(["titre","commune","categorie","description","source","lienSource","dateFin","statut","createdAt","publiePar"])
        && request.resource.data.keys().hasOnly(["titre","commune","categorie","description","source","lienSource","dateFin","statut","createdAt","publiePar"])
        && request.resource.data.titre is string && request.resource.data.titre.size() >= 4 && request.resource.data.titre.size() <= 120
        && request.resource.data.commune is string && request.resource.data.commune.size() >= 2 && request.resource.data.commune.size() <= 80
        && request.resource.data.categorie in ["routes","eau_electricite","municipal","securite","evenement","autre"]
        && request.resource.data.description is string && request.resource.data.description.size() >= 10 && request.resource.data.description.size() <= 1800
        && request.resource.data.source is string && request.resource.data.source.size() <= 160
        && request.resource.data.lienSource is string && request.resource.data.lienSource.size() <= 500
        && request.resource.data.dateFin is string && request.resource.data.dateFin.size() <= 10
        && request.resource.data.statut == "publiee"
        && request.resource.data.createdAt == request.time
        && request.resource.data.publiePar == request.auth.uid;
      allow update: if estAdmin();
      allow delete: if estAdmin();
    }

    // Propositions d'informations locales : lecture privée à l'administrateur, création par un compte connecté.
    match /propositions_communes/{propositionId} {
      allow create: if estConnecte()
        && request.resource.data.keys().hasAll(["uid","email","titre","commune","categorie","description","source","lienSource","statut","createdAt"])
        && request.resource.data.keys().hasOnly(["uid","email","titre","commune","categorie","description","source","lienSource","statut","createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.titre is string && request.resource.data.titre.size() >= 4 && request.resource.data.titre.size() <= 120
        && request.resource.data.commune is string && request.resource.data.commune.size() >= 2 && request.resource.data.commune.size() <= 80
        && request.resource.data.categorie in ["routes","eau_electricite","municipal","securite","evenement","autre"]
        && request.resource.data.description is string && request.resource.data.description.size() >= 10 && request.resource.data.description.size() <= 1800
        && request.resource.data.source is string && request.resource.data.source.size() <= 160
        && request.resource.data.lienSource is string && request.resource.data.lienSource.size() <= 500
        && request.resource.data.statut == "en_attente"
        && request.resource.data.createdAt == request.time;
      allow read: if estAdmin();
      allow update: if estAdmin();
      allow delete: if estAdmin();
    }

    // Paramètres des abonnements : lecture pour les comptes connectés,
    // modification réservée à l'administrateur. Les annuaires ne sont pas configurables ici.
    match /configuration_abonnements/{configId} {
      allow read: if estConnecte();
      allow create, update, delete: if estAdmin() && configId == "globale";
    }

    match /{document=**} {
      allow read, write: if false;
    }
    // File d'attente des notifications : seul l'administrateur peut créer ou consulter les événements.
    // Le Worker utilise un compte de service côté serveur et contourne les règles Firestore.
    match /notifications_queue/{eventId} {
      allow read, create, update, delete: if estAdmin();
    }

  }
}
