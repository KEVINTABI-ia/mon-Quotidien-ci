rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function estAdmin() {
      return request.auth != null && request.auth.uid == "3LpoTLyQdtVcdtnSMAJFc7Cvnpz2";
    }
    match /declarations_enfants_privees/{uid}/{dossierId}/{fileName} {
      allow create: if resource == null
        && request.auth != null && request.auth.uid == uid
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow read: if estAdmin();
      allow update: if false;
      allow delete: if false;
    }
    match /declarations_enfants_publics/{dossierId}/{fileName} {
      allow read: if true;
      allow create: if resource == null && estAdmin()
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update: if false;
      allow delete: if false;
    }

    match /demandes_pharmacie_documents/{uid}/{demandeId}/{fileName} {
      allow create: if resource == null && request.auth != null && request.auth.uid == uid
        && fileName.matches('^[A-Za-z0-9._-]{1,180}$')
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp)|application/pdf)');
      allow read: if estAdmin()
        || (request.auth != null
          && firestore.get(/databases/(default)/documents/pharmacies_professionnelles/$(request.auth.uid)).data.statut == "approuve"
          && firestore.get(/databases/(default)/documents/demandes_pharmacie/$(demandeId)).data.pharmacieAssigneeUid == request.auth.uid);
      allow update, delete: if false;
    }
    match /trajet_partage_documents/{uid}/{fileName} {
      allow create: if resource == null
        && request.auth != null && request.auth.uid == uid
        && fileName.matches('^(permis|carteGrise|assurance)\\.(jpg|jpeg|png|webp|pdf)$')
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp)|application/pdf)');
      allow read: if estAdmin();
      allow update, delete: if false;
    }

    // Médias de l’espace publicitaire : dépôt réservé à l’administrateur.
    // Les fichiers sont consultables publiquement sur la page d’accueil.
    match /publicites/{fileName} {
      allow read: if true;
      allow create: if resource == null && estAdmin()
        && fileName.matches('^[A-Za-z0-9._-]{1,180}$')
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp)|video/(mp4|webm|quicktime))');
      allow update, delete: if false;
    }

    match /logement_photos/{uid}/{annonceId}/{fileName} {
      allow create: if resource == null
        && request.auth != null && request.auth.uid == uid
        && fileName.size() <= 180
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
