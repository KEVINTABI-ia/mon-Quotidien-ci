rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function estAdmin() {
      return request.auth != null && request.auth.uid == "3LpoTLyQdtVcdtnSMAJFc7Cvnpz2";
    }

    // Logos de compagnies: consultation publique, dépôt par un compte authentifié.
    match /compagnies/logos/{uid}/{fileName} {
      allow read: if true;
      allow create: if resource == null
        && request.auth != null && request.auth.uid == uid
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update: if false;
      allow delete: if estAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // Créations publicitaires réservées à l'administrateur; médias servis publiquement.
    match /publicites/{fileName} {
      allow read: if true;
      allow create: if resource == null && estAdmin()
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp)|video/(mp4|webm|quicktime))');
      allow update: if false;
      allow delete: if estAdmin();
    }

    match /declarations_enfants_privees/{uid}/{dossierId}/{fileName} {
      allow create: if resource == null
        && request.auth != null && request.auth.uid == uid
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow read: if estAdmin();
      allow update: if false;
      allow delete: if false;
    }
    match /declarations_enfants_publics/{dossierId}/{fileName} {
      allow read: if true;
      allow create: if resource == null && estAdmin()
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update: if false;
      allow delete: if false;
    }
  }
}