rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function estAdmin() {
      return request.auth != null && request.auth.uid == "3LpoTLyQdtVcdtnSMAJFc7Cvnpz2";
    }
    match /declarations_enfants_privees/{uid}/{dossierId}/{fileName} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow read: if estAdmin();
      allow update: if estAdmin();
      allow delete: if false;
    }
    match /declarations_enfants_publics/{dossierId}/{fileName} {
      allow read: if true;
      allow create, update: if estAdmin()
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if false;
    }
  }
}